# Added automatically when you connect an Upstash Redis store in the Vercel dashboard
# (Storage -> Create -> Upstash for Redis). Either naming scheme works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Shared secret the laptop agents send in the x-agent-key header.
# Leave empty to disable the check (fine for local testing only).
AGENT_KEY=
